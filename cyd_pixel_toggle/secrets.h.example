// secrets.h - your Wi-Fi details. Keep this file private (do not share or upload it).
//
// The CYD board can only join 2.4 GHz Wi-Fi (not 5 GHz). If your router has one
// combined name for both, that is fine. Keep the quote marks.
//
// flash_cyd.sh copies this file to secrets.h and asks you for the real values.
// (Or copy it yourself: cp secrets.h.example secrets.h, then edit secrets.h.)
// secrets.h is in .gitignore, so it never gets committed.
#pragma once

#define WIFI_SSID     "YOUR_WIFI_NAME"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"
